# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# PostgreSQL - matches docker-compose.yml
DATABASE_URL=postgresql+asyncpg://triage_user:triage_pass@localhost:5432/triage_db

# JWT - generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_generate_a_real_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Groq (Slice 3 - leave blank for Slice 1 & 2)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
